package-as: PolestarPack_Nood

# 커스포지 필수 의존성: https://www.curseforge.com/wow/addons/polestar
required-dependencies:
  - polestar

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - CHANGELOG.md
  - README.md
  - tools
  - packs
  - setup

# move-folders 는 배포 때 워크플로가 빌드 결과(폴더 목록)에 맞춰 이 아래에 덧붙입니다.
